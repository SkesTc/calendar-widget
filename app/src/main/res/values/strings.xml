    <string-array name="tips_xiaomi">
        <item>App info → turn on “Autostart”</item>
        <item>App info → Battery saver → “No restrictions”</item>
        <item>In Recents, pull the app down to lock it so it isn’t cleared</item>
    </string-array>
    <string-array name="tips_samsung">
        <item>App info → Battery → “Unrestricted”</item>
        <item>Settings → Battery → Background usage limits: make sure this app isn’t in Sleeping or Deep sleeping apps</item>
    </string-array>
    <string-array name="tips_oppo">
        <item>App info → Battery usage → allow background activity and auto launch</item>
    </string-array>
    <string-array name="tips_vivo">
        <item>i Manager → App manager → Autostart: allow this app</item>
        <item>Settings → Battery → Background power consumption: allow this app</item>
    </string-array>
    <string-array name="tips_huawei">
        <item>Settings → Battery → App launch: set this app to “Manage manually” and turn everything on</item>
    </string-array>
    <string-array name="tips_asus">
        <item>Mobile Manager → Auto-start Manager: allow this app</item>
    </string-array>
    <string-array name="tips_generic">
        <item>App info → Battery → “Unrestricted” (or turn off battery optimization)</item>
    </string-array>
